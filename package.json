{
  "name": "workbench-toolbox",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A local desktop toolbox with development planning and Git management",
  "author": "Workbench",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1 --port 5207",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test": "tsc -p tsconfig.electron.json && node --test tests/git.test.cjs tests/json.test.cjs tests/time.test.cjs tests/toolkit.test.cjs tests/management.test.cjs tests/management-schedule.test.cjs tests/management-week-report.test.cjs tests/management-numbering.test.cjs tests/management-io.test.cjs tests/management-web.test.cjs",
    "test:management": "tsc -p tsconfig.electron.json && node --test tests/management.test.cjs tests/management-schedule.test.cjs tests/management-week-report.test.cjs tests/management-numbering.test.cjs tests/management-io.test.cjs tests/management-web.test.cjs",
    "test:tools": "tsc -p tsconfig.electron.json && node --test tests/toolkit.test.cjs",
    "test:json": "tsc -p tsconfig.electron.json && node --test tests/json.test.cjs",
    "test:time": "tsc -p tsconfig.electron.json && node --test tests/time.test.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@js-temporal/polyfill": "^0.5.1",
    "@lezer/highlight": "^1.2.5",
    "diff": "^9.0.0",
    "element-plus": "^2.11.5",
    "exceljs": "^4.4.0",
    "hash-wasm": "^4.12.0",
    "he": "^2.0.0",
    "jwt-decode": "^4.0.0",
    "lossless-json": "^4.3.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.1",
    "sql.js": "^1.13.0",
    "uuid": "^11.1.1",
    "vue": "^3.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/he": "^1.2.3",
    "@types/node": "^22.18.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "playwright": "1.58.2",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "local.workbench.toolbox",
    "productName": "Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Workbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
